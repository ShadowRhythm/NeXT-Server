[Unit]
Description=NeXT Server
Documentation=https://github.com/ShadowRhythm/NeXT-Server
After=network.target nss-lookup.target
Wants=network.target

[Service]
User=root
Group=root
Type=simple
LimitAS=infinity
LimitRSS=infinity
LimitCORE=infinity
LimitNOFILE=65535
WorkingDirectory=/usr/local/next-server/
ExecStart=/usr/local/next-server/next-server --config /etc/next-server/config.json
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
